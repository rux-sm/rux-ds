# Quarry — Carbon source material. Read from, never shipped.
# carbon-website carries its own .git; ignoring it also avoids a nested repo.
carbon-website/
node_modules/

# Build scratch
.sass-cache/
*.css.map
m/

# Brand working directory -- a Linearity Curve template, a preview harness and
# a drop folder for iPad exports. Working material, not a deliverable: the
# finished marks belong in assets/brand/ once they are drawn. Ignored rather
# than left untracked because git add -A would otherwise sweep it in whole.
.brand/

# macOS
.DS_Store

# Agent worktrees. Transient, and each carries its own .git -- committing one
# embeds a repository nobody can clone.
.claude/worktrees/
