{
  "permissions": {
    "allow": [
      "mcp__Claude_Browser__read_console_messages",
      "mcp__Claude_Browser__read_page",
      "mcp__Claude_Browser__read_network_requests",
      "mcp__Claude_Browser__get_page_text",
      "mcp__Claude_Browser__tabs_context",
      "mcp__Claude_Browser__preview_list"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node tools/exchange.mjs 2>/dev/null | jq -Rs '{hookSpecificOutput:{hookEventName:\"SessionStart\",additionalContext:.}}' || true",
            "timeout": 15,
            "statusMessage": "Reading open cross-repo asks"
          }
        ]
      }
    ]
  }
}
